prefix=${pcfiledir}/@LLAM_PC_PREFIX_RELATIVE@
exec_prefix=${prefix}
libdir=@LLAM_PC_LIBDIR@
includedir=@LLAM_PC_INCLUDEDIR@

Name: LLAM
Description: Stackful user-thread runtime for C applications
Version: @LLAM_LIBRARY_VERSION@
Libs: -L${libdir} -lllam_runtime
Libs.private: @LLAM_PC_PRIVATE_LIBS@
Cflags: -I${includedir}
