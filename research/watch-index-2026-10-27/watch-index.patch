+            CHECK(llam_find_poll_watch_locked(node, fds[j][0], POLLOUT) == NULL);
+            CHECK(llam_find_recv_watch_locked(node, fds[j][0], recvs[j]->st_dev, recvs[j]->st_ino ^ 1U) ==
