+#include <sched.h>
+#define CHECK(condition)                                                                                     \
+    do {                                                                                                     \
+        if (!(condition)) {                                                                                  \
+            fprintf(stderr, "watch index check failed: %s at %d (errno=%d)\n", #condition, __LINE__, errno); \
+            abort();                                                                                         \
+        }                                                                                                    \
+    } while (0)
