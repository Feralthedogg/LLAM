+static bool llamLateRefuse(const MachineFunction &MF, std::string &Why) {
+  const Function &Fn = MF.getFunction();
+  const MachineFrameInfo &Frame = MF.getFrameInfo();
+  const X86Subtarget &Subtarget = MF.getSubtarget<X86Subtarget>();
+  if (llamX86MCEmitsUnqualifiedPadding()) {
+    Why = "EMISSION_PROFILE MC branch/prefix padding";
+    return true;
+  }
+  if (Subtarget.hardenSlsRet() || Subtarget.hardenSlsIJmp()) {
+    Why = "EMISSION_PROFILE SLS hardening";
+    return true;
+  }
+  if (Fn.isVarArg() ||
+      !(Fn.getReturnType()->isIntegerTy(32) ||
+        Fn.getReturnType()->isIntegerTy(64))) {
+    Why = "SIGNATURE return/varargs";
+    return true;
+  }
+  for (const Argument &Arg : Fn.args()) {
+    if (!(Arg.getType()->isIntegerTy(32) ||
+          Arg.getType()->isIntegerTy(64))) {
+      Why = "SIGNATURE argument";
+      return true;
+    }
+  }
+  if (MF.hasBBSections() || MF.getJumpTableInfo() || MF.hasEHFunclets() ||
+      MF.hasEHScopes() || MF.isOutlined() || Fn.hasPrefixData() ||
+      Fn.hasPrologueData() || Fn.hasPersonalityFn() ||
+      Fn.hasFnAttribute("patchable-function-entry") ||
+      Fn.hasFnAttribute("patchable-function-prefix")) {
+    Why = "LAYOUT split/jump-table/funclet/prefix";
+    return true;
+  }
+  for (const MachineBasicBlock &Block : MF) {
+    for (const MachineInstr &MI : Block) {
+      if (MI.isCall() || MI.getOpcode() == X86::TAILJMPd64 ||
+          MI.getOpcode() == X86::TAILJMPr64) {
+        Why = (Twine("CALL_OR_TAIL ") +
+               MF.getSubtarget().getInstrInfo()->getName(MI.getOpcode())).str();
+        return true;
+      }
+      if (MI.isIndirectBranch() ||
+          (MI.isReturn() && MI.getOpcode() != X86::RET64)) {
+        Why = (Twine("CONTROL_FLOW ") +
+               MF.getSubtarget().getInstrInfo()->getName(MI.getOpcode())).str();
+        return true;
+      }
+    }
+  }
+  for (const MachineBasicBlock &Block : MF) {
+    for (const MachineInstr &MI : Block) {
+      if (MI.getOpcode() != X86::RET64 &&
+          (MI.mayLoadOrStore() || MI.isInlineAsm() ||
+           MI.hasUnmodeledSideEffects())) {
+        Why = (Twine("MEMORY_OR_EFFECT ") +
+               MF.getSubtarget().getInstrInfo()->getName(MI.getOpcode())).str();
+        return true;
+      }
+    }
+  }
+  for (const MachineBasicBlock &Block : MF) {
+    if (&Block != &MF.front() && Block.getAlignment().value() > 1U) {
+      Why = "LAYOUT in-range aligned block";
+      return true;
+    }
+    for (const MachineInstr &MI : Block) {
+      unsigned Opcode = MI.getOpcode();
+      StringRef OpcodeName = MF.getSubtarget().getInstrInfo()->getName(Opcode);
+      if (MI.isDebugInstr() || MI.isCFIInstruction() ||
+          Opcode == TargetOpcode::KILL || Opcode == TargetOpcode::IMPLICIT_DEF)
+        continue;
+      if (Opcode != X86::RET64 &&
+          (MI.mayLoadOrStore() || MI.isCall() || MI.isInlineAsm() ||
+           MI.hasUnmodeledSideEffects())) {
+        Why = (Twine("MEMORY_OR_EFFECT ") + OpcodeName).str();
+        return true;
+      }
+      if (MI.isPseudo()) {
+        Why = (Twine("UNKNOWN_LOWERING ") + OpcodeName).str();
+        return true;
+      }
+      bool IsBranch = Opcode == X86::JCC_1;
+      if (Opcode == X86::LEA64r) {
+        for (const MachineOperand &Operand : MI.operands()) {
+          if (Operand.getTargetFlags() != 0U) {
+            Why = "CONTROL_OR_SYMBOL LEA64r";
+            return true;
+          }
+        }
+        if (MI.getNumOperands() != 6U ||
+          MI.getNumExplicitOperands() != 6U || !MI.getOperand(0).isReg() ||
+            !llamVolatileIntegerReg(MI.getOperand(0).getReg()) ||
+            !MI.getOperand(1).isReg() || !MI.getOperand(2).isImm() ||
+            !MI.getOperand(3).isReg() || !MI.getOperand(4).isImm() ||
+            !MI.getOperand(5).isReg() ||
+            MI.getOperand(5).getReg().id() != 0U ||
+            (MI.getOperand(1).getReg().id() == 0U &&
+             MI.getOperand(3).getReg().id() == 0U) ||
+            (MI.getOperand(1).getReg().id() != 0U &&
+             !llamVolatileIntegerReg(MI.getOperand(1).getReg())) ||
+            (MI.getOperand(3).getReg().id() != 0U &&
+             !llamVolatileIntegerReg(MI.getOperand(3).getReg())) ||
+            (MI.getOperand(2).getImm() != 1 &&
+             MI.getOperand(2).getImm() != 2 &&
+             MI.getOperand(2).getImm() != 4 &&
+             MI.getOperand(2).getImm() != 8)) {
+          Why = "SPECIAL_REGISTER_OR_LEA_ADDRESS";
+          return true;
+        }
+        continue;
+      }
+      switch (Opcode) {
+      case X86::MOV32ri: case X86::MOV64rr:
+      case X86::ADD64ri32:
+      case X86::INC64r: case X86::DEC64r: case X86::SUB64rr:
+      case X86::XOR32rr: case X86::XOR64rr:
+      case X86::SHL64ri: case X86::SHR64ri:
+      case X86::TEST64rr: case X86::CMP64ri32:
+      case X86::JCC_1: case X86::RET64:
+        break;
+      default:
+        Why = (Twine("UNKNOWN_LOWERING ") + OpcodeName).str();
+        return true;
+      }
+      if (!llamExplicitShape(MI)) {
+        Why = (Twine("OPERAND_SHAPE ") + OpcodeName).str();
+        return true;
+      }
+      if (Opcode == X86::JCC_1 &&
+          (MI.getNumOperands() < 2U || !MI.getOperand(0).isMBB() ||
+           !MI.getOperand(1).isImm() || MI.getOperand(1).getImm() < 0 ||
+           MI.getOperand(1).getImm() > 15)) {
+        Why = "CONTROL_FLOW conditional branch";
+        return true;
+      }
+      for (const MachineOperand &Operand : MI.operands()) {
+        if (Operand.getTargetFlags() != 0U) {
+          Why = (Twine("CONTROL_OR_SYMBOL ") + OpcodeName).str();
+          return true;
+        }
+        if (Operand.isReg()) {
+          Register Reg = Operand.getReg();
+          if (Reg.id() == X86::EFLAGS && Operand.isImplicit())
+            continue;
+          if (!llamVolatileIntegerReg(Reg)) {
+            Why = (Twine("SPECIAL_REGISTER ") + OpcodeName).str();
+            return true;
+          }
+        } else if (Operand.isImm()) {
+          continue;
+        } else if (Operand.isMBB() && IsBranch &&
+                   Operand.getMBB()->getParent() == &MF) {
+          continue;
+        } else {
+          Why = (Twine("CONTROL_OR_SYMBOL ") + OpcodeName).str();
+          return true;
+        }
+      }
+    }
+  }
+  if (Frame.getNumObjects() || Frame.getStackSize() ||
+      Frame.hasVarSizedObjects() || Frame.adjustsStack() ||
+      Frame.hasOpaqueSPAdjustment() || Frame.hasCalls() ||
+      Frame.hasTailCall() || Frame.hasStackMap() || Frame.hasPatchPoint() ||
+      Frame.isFrameAddressTaken() || Frame.isReturnAddressTaken()) {
+    Why = "FRAME stack/adjustment/call";
+    return true;
+  }
+  return false;
+}
