+static bool llamVolatileIntegerReg(Register Reg) {
+  switch (Reg.id()) {
+  case X86::RAX: case X86::EAX:
+  case X86::RCX: case X86::ECX:
+  case X86::RDX: case X86::EDX:
+  case X86::R8: case X86::R8D:
+  case X86::R9: case X86::R9D:
+  case X86::R10: case X86::R10D:
+  case X86::R11: case X86::R11D:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static bool llamExplicitShape(const MachineInstr &MI) {
+  unsigned Count = MI.getNumExplicitOperands();
+  auto IsReg = [&](unsigned Index) {
+    return Index < Count && MI.getOperand(Index).isReg();
+  };
+  auto IsImm = [&](unsigned Index) {
+    return Index < Count && MI.getOperand(Index).isImm();
+  };
+  auto IsBlock = [&](unsigned Index) {
+    return Index < Count && MI.getOperand(Index).isMBB();
+  };
+  switch (MI.getOpcode()) {
+  case X86::MOV32ri:
+    return Count == 2 && IsReg(0) && IsImm(1);
+  case X86::MOV64rr: case X86::INC64r: case X86::DEC64r:
+  case X86::TEST64rr:
+    return Count == 2 && IsReg(0) && IsReg(1);
+  case X86::SUB64rr:
+  case X86::XOR32rr: case X86::XOR64rr:
+    return Count == 3 && IsReg(0) && IsReg(1) && IsReg(2);
+  case X86::ADD64ri32: case X86::SHL64ri: case X86::SHR64ri:
+    return Count == 3 && IsReg(0) && IsReg(1) && IsImm(2);
+  case X86::CMP64ri32:
+    return Count == 2 && IsReg(0) && IsImm(1);
+  case X86::JCC_1:
+    return Count == 2 && IsBlock(0) && IsImm(1);
+  case X86::RET64:
+    return Count == 1 && IsReg(0) &&
+           (MI.getOperand(0).getReg().id() == X86::RAX ||
+            MI.getOperand(0).getReg().id() == X86::EAX);
+  default:
+    return false;
+  }
+}
