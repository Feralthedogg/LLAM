+class LLAMPreemptEndProbe final : public AsmPrinterHandler {
+  X86AsmPrinter &Printer;
+  const MachineFunction *Selected = nullptr;
+  MCSymbol *Begin = nullptr;
+  MCSymbol *End = nullptr;
+  MCSectionCOFF *CodeSection = nullptr;
+  MCSymbol *CodeLeader = nullptr;
+  bool Transport = false;
+  bool Certified = false;
+  unsigned EmittedCertificates = 0;
+
+public:
+  explicit LLAMPreemptEndProbe(X86AsmPrinter &Printer) : Printer(Printer) {}
+
+  void beginFunction(const MachineFunction *MF) override {
+    Selected = nullptr;
+    Begin = nullptr;
+    End = nullptr;
+    CodeSection = nullptr;
+    CodeLeader = nullptr;
+    Transport = false;
+    Certified = false;
+    const Function &Fn = MF->getFunction();
+    bool EarlyAccepted = Fn.hasFnAttribute("llam.preempt.win64_ir_accepted");
+    bool EarlyRequested = Fn.hasFnAttribute("llam.preempt.async_requested");
+    if (LLAMPreemptCertify && EarlyRequested != EarlyAccepted)
+      report_fatal_error(Twine("LLAM Win64 IR provenance mismatch ") +
+                         MF->getName());
+    Certified = LLAMPreemptCertify && EarlyRequested && EarlyAccepted;
+    if (Certified) {
+      std::string Why;
+      if (llamLateRefuse(*MF, Why))
+        report_fatal_error(Twine("LLAM Win64 certification rejected ") +
+                           MF->getName() + ": " + Why);
+    }
+    if ((LLAMPreemptLateAudit || LLAMPreemptLateRequire) &&
+        (Fn.hasFnAttribute("llam.preempt.late_probe") || EarlyAccepted)) {
+      std::string Why;
+      if (llamLateRefuse(*MF, Why)) {
+        if (LLAMPreemptLateRequire)
+          report_fatal_error(Twine("LLAM late profile rejected ") +
+                             MF->getName() + ": " + Why);
+        errs() << "llam-late-audit: REFUSE " << MF->getName() << " " << Why
+               << "\n";
+      } else if (LLAMPreemptLateAudit) {
+        errs() << "llam-late-audit: PASS_BODY " << MF->getName() << "\n";
+      }
+    }
+    Transport = LLAMPreemptProbeLLPM &&
+                Fn.hasFnAttribute("llam.preempt.transport_fixture");
+    Selected = Certified || Transport || Fn.hasFnAttribute("llam.preempt.probe")
+                   ? MF
+                   : nullptr;
+    if (!Selected)
+      return;
+    Begin = Printer.CurrentFnSym;
+    CodeSection = static_cast<MCSectionCOFF *>(
+        Printer.OutStreamer->getCurrentSectionOnly());
+    CodeLeader = CodeSection->getCOMDATSymbol();
+    if ((Certified || Transport) &&
+        (Begin == nullptr || CodeLeader == nullptr ||
+         CodeSection->getSelection() !=
+             COFF::IMAGE_COMDAT_SELECT_NODUPLICATES ||
+         MF->hasBBSections() || MF->getJumpTableInfo() != nullptr))
+      report_fatal_error(Twine("LLAM certified/transport function needs one one-only code section: ") +
+                         MF->getName());
+  }
+
+  void markFunctionEnd() override {
+    if (!Selected)
+      return;
+    if (Printer.OutStreamer->getCurrentSectionOnly() != CodeSection)
+      report_fatal_error("LLAM endpoint moved out of its code section");
+    End = Printer.OutContext.createNamedTempSymbol();
+    Printer.OutStreamer->emitLabel(End);
+  }
+
+  void endFunction(const MachineFunction *) override {
+    if (Certified || Transport) {
+      if (!Begin || !End || !CodeLeader)
+        report_fatal_error("LLAM transport fixture has no codegen boundary");
+      MCContext &Ctx = Printer.OutContext;
+      MCStreamer &Stream = *Printer.OutStreamer;
+      MCSectionCOFF *Base = Ctx.getCOFFSection(
+          ".llampm$M", COFF::IMAGE_SCN_CNT_INITIALIZED_DATA |
+                            COFF::IMAGE_SCN_MEM_READ);
+      MCSectionCOFF *Meta =
+          Ctx.getAssociativeCOFFSection(Base, CodeLeader);
+      Stream.pushSection();
+      Stream.switchSection(Meta);
+      Stream.emitValueToAlignment(Align(4));
+      Stream.emitInt32(0x4d504c4c);
+      Stream.emitInt16(1);
+      Stream.emitInt16(1);
+      Stream.emitInt32(32);
+      Stream.emitInt32(48);
+      Stream.emitInt64(0);
+      Stream.emitInt32(1);
+      Stream.emitInt32(4);
+      MCSymbol *BeginField = Ctx.createTempSymbol("llam_begin_field");
+      Stream.emitLabel(BeginField);
+      Stream.emitValue(MCBinaryExpr::createSub(
+                           MCSymbolRefExpr::create(Begin, Ctx),
+                           MCSymbolRefExpr::create(BeginField, Ctx), Ctx),
+                       4);
+      MCSymbol *EndField = Ctx.createTempSymbol("llam_end_field");
+      Stream.emitLabel(EndField);
+      Stream.emitValue(MCBinaryExpr::createSub(
+                           MCSymbolRefExpr::create(End, Ctx),
+                           MCSymbolRefExpr::create(EndField, Ctx), Ctx),
+                       4);
+      Stream.emitInt32(1);
+      Stream.emitInt32(0);
+      Stream.popSection();
+      if (Certified)
+        ++EmittedCertificates;
+    }
+    Selected = nullptr;
+    Begin = nullptr;
+    End = nullptr;
+    CodeSection = nullptr;
+    CodeLeader = nullptr;
+    Transport = false;
+    Certified = false;
+  }
+  void endModule() override {
+    if (LLAMPreemptCertify && EmittedCertificates == 0U)
+      report_fatal_error("LLAM Win64 certification found no accepted function");
+  }
+};
+
 X86AsmPrinter::X86AsmPrinter(TargetMachine &TM,
                              std::unique_ptr<MCStreamer> Streamer)
     : AsmPrinter(TM, std::move(Streamer), ID), FM(*this) {
+  if (LLAMPreemptCertify && LLAMPreemptProbeLLPM)
+    report_fatal_error("LLAM certification and manual transport modes are exclusive");
+  if (LLAMPreemptCertify && !TM.getTargetTriple().isWindowsGNUEnvironment())
+    report_fatal_error("LLAM certification requires Windows GNU/COFF target");
+  if ((LLAMPreemptProbeLLPM || LLAMPreemptLateAudit ||
+       LLAMPreemptLateRequire || LLAMPreemptCertify) &&
+      TM.Options.BBSections != BasicBlockSection::None)
+    report_fatal_error("LLAM late profile rejected: LAYOUT basic-block sections");
+  if (LLAMPreemptProbeLLPM && llamX86MCEmitsUnqualifiedPadding())
+    report_fatal_error("LLAM transport fixture rejected: MC branch/prefix padding");
+  if ((LLAMPreemptProbeEnd || LLAMPreemptProbeLLPM || LLAMPreemptLateAudit ||
+       LLAMPreemptLateRequire || LLAMPreemptCertify) &&
+      TM.getTargetTriple().isOSWindows() &&
+      TM.getTargetTriple().isOSBinFormatCOFF() &&
+      TM.getTargetTriple().getArch() == Triple::x86_64)
+    addAsmPrinterHandler(std::make_unique<LLAMPreemptEndProbe>(*this));
   GetPSI = [this](Module &M) -> ProfileSummaryInfo * {
     if (auto *PSIW = getAnalysisIfAvailable<ProfileSummaryInfoWrapperPass>())
       return &PSIW->getPSI();
