llam_driver_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 1
for llam_driver in \
    "$llam_driver_dir/preempt/managed_driver.py" \
    "$llam_driver_dir/../libexec/llam/managed_driver.py" \
    "$llam_driver_dir"/../libexec*/llam/managed_driver.py; do
    if [ -f "$llam_driver" ]; then
        exec python3 "$llam_driver" "$@"
    fi
done
printf 'llam-managed-clang: installed managed driver is unavailable\n' >&2
exit 77
